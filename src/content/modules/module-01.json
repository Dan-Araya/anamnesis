  "sentences": [
    {
      "id": "m01-s1",
      "greek": "ὁ ἄνθρωπος ἀγαθός ἐστιν.",
      "es": ["El hombre es bueno."]
    },
    {
      "id": "m01-s2",
      "greek": "καλὴ ἡ νῆσος καὶ καλὰ τὰ ἔργα.",
      "es": [
        "Hermosa es la isla y hermosas las obras.",
        "La isla es hermosa y las obras son hermosas."
      ],
      "hint": "El verbo «ser» puede quedar sobreentendido."
    },
    {
      "id": "m01-s3",
      "greek": "οἱ μὲν θεοὶ ἐν τῇ νήσῳ, οἱ δὲ ἄνθρωποι οὔ.",
      "es": ["Los dioses están en la isla, pero los hombres no."],
      "hint": "μέν… δέ… contrapone dos miembros."
    }
  ],
  "grammar": [
    {
      "id": "m01-g1",
      "title": "El artículo y la posición atributiva",
      "body": "El adjetivo entre artículo y sustantivo es atributivo: ὁ ἀγαθὸς ἄνθρωπος = «el hombre bueno». Fuera de esa posición, con el sustantivo articulado, es predicativo: ἀγαθὸς ὁ ἄνθρωπος = «el hombre es bueno»."
    },
    {
      "id": "m01-g2",
      "title": "Orden de palabras",
      "body": "El griego marca la función con el caso, no con el orden. ὁ ἄνθρωπος τὸν θεὸν ὁρᾷ y τὸν θεὸν ὁ ἄνθρωπος ὁρᾷ significan lo mismo; cambia el énfasis."
    }
  ]
